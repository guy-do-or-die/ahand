{
  "name": "ahand",
  "version": "1.0.0",
  "description": "aHand Protocol",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/abi",
    "packages/sdk",
    "packages/deliver",
    "packages/card",
    "infra/relay",
    "infra/stand",
    "apps/view",
    "apps/web",
    "tools"
  ],
  "scripts": {
    "check:core": "echo '118f4d37f8a9d54d33245760b0f5871cbb79bf9bf4a7f152d89e84ef5713d738  contracts/src/AHandCore.sol' | sha256sum --check --strict",
    "build:contracts": "cd contracts && ${FOUNDRY_BIN:-$HOME/.foundry/bin}/forge build",
    "check:abi": "bun run --cwd packages/abi check",
    "test:contracts": "cd contracts && ${FOUNDRY_BIN:-$HOME/.foundry/bin}/forge test",
    "test:vectors": "cd contracts && WRITE_VECTORS=true ${FOUNDRY_BIN:-$HOME/.foundry/bin}/forge test --match-contract 'SdkVectorsTest|SdkGasTest' && git diff --exit-code -- test/fixtures",
    "test:exit": "bash contracts/exit/selftest.sh",
    "typecheck": "bun infra/gate/gate.ts typecheck",
    "test:sdk": "bun run --cwd packages/sdk test",
    "test:abi": "bun run --cwd packages/abi test",
    "test:deliver": "bun run --cwd packages/deliver test",
    "test:card": "bun run --cwd packages/card test",
    "test:relay": "bun run --cwd infra/relay test",
    "test:view": "bun run --cwd apps/view test",
    "test:web": "bun run --cwd apps/web test",
    "test:stand": "bun run --cwd infra/stand test",
    "test:tools": "bun run --cwd tools test",
    "test:gate": "bun test infra/gate",
    "build": "bun run --cwd apps/web build",
    "stand": "bun infra/stand/stand.ts",
    "e2e": "playwright test tests/e2e",
    "check": "bun infra/gate/gate.ts",
    "demo": "playwright test -c playwright.demo.config.ts",
    "check:catalogue": "bun tests/demo/catalogue.ts --check",
    "check:atlas": "bun tests/demo/atlas.ts --check-routes",
    "show": "bun tests/demo/show.ts"
  },
  "devDependencies": {
    "@ahand/abi": "workspace:*",
    "@ahand/deliver": "workspace:*",
    "@ahand/sdk": "workspace:*",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@rrweb/record": "2.2.2",
    "@rrweb/replay": "2.2.2",
    "@types/bun": "1.4.4",
    "typescript": "5.9.3",
    "viem": "2.58.4",
    "xstate": "5.33.4"
  },
  "overrides": {
    "typescript": "5.9.3",
    "viem": "2.58.4"
  }
}
