# aHand web app environment
#
# VITE_* vars are baked into the client bundle at BUILD time — set them in
# Vercel (Production/Preview) and rebuild for changes to take effect.
# Everything has a local-dev default, so an empty env runs the anvil stand
# out of the box; production needs the values below.

# ── Chain ────────────────────────────────────────────────────────────────
# Active chain: anvil (default) | base | baseSepolia | worldchain
# Anything else silently falls back to anvil — beware typos.
VITE_CHAIN=baseSepolia

# RPC override for the active public chain. Optional — falls back to the
# chain's public RPC; use a dedicated endpoint in production to dodge
# rate limits (Alchemy/Infura/QuickNode/...).
VITE_RPC_URL=

# Mainnet RPC for read-only ENS resolution (names live on L1 regardless of
# the active chain). Optional; override when the public default rate-limits.
VITE_ENS_RPC=

# ── Public origin ────────────────────────────────────────────────────────
# Canonical origin used for SSR metadata / OG links. Never localhost.
# Dev default is the ngrok tunnel; production must set the real domain.
VITE_PUBLIC_ORIGIN=https://ahand.in

# ── Auth (Privy) ─────────────────────────────────────────────────────────
# Public app id (not a secret). Defaults to the aHand production app.
VITE_PRIVY_APP_ID=

# ── Account abstraction ──────────────────────────────────────────────────
# Master switch for social logins + sponsored sends. "false" disables.
VITE_AA_ENABLED=true

# Bundler / paymaster endpoints. Local default is /api/aa (the anvil stand's
# mock paymaster proxy serves both roles). In production point both at a
# real provider, e.g. https://api.pimlico.io/v2/84532/rpc?apikey=...
# (84532 = Base Sepolia, 8453 = Base mainnet).
VITE_AA_BUNDLER_URL=
VITE_AA_PAYMASTER_URL=

# Pimlico sponsorship policy id (sp_...). Optional.
VITE_AA_SPONSORSHIP_POLICY_ID=

# Simple7702Account implementation override. Optional — the canonical
# eth-infinitism v0.8 address is baked in.
VITE_AA_IMPLEMENTATION=

# ── Server-side (functions runtime, not baked into the bundle) ───────────
# Upstream for the /api/aa proxy route. Only used when the AA urls above
# point at /api/aa (local stand); default http://127.0.0.1:4339.
AA_LOCAL_URL=
