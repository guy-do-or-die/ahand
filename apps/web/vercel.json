{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && bun install --frozen-lockfile",
  "buildCommand": "cd ../.. && bun apps/hand/vercel.ts build",
  "outputDirectory": "dist",
  "functions": {
    "api/face.mjs": {
      "includeFiles": "face/**",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/([0-9]+/(?:0x[0-9a-fA-F]{40}/)?[0-9]+)",
      "destination": "/api/face"
    },
    {
      "source": "/og/(generic|[0-9]+/(?:0x[0-9a-fA-F]{40}/)?[0-9]+)\\.png",
      "destination": "/api/face"
    },
    {
      "source": "/((?:[^/]*/)*[^/.]*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/((?!exit\\.html$).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://sepolia.base.org wss://relay.damus.io wss://nos.lol; worker-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/exit.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-xvnnfLGBHHO2+qw5XqNpzs+WRyfhd89nN3p78+I+M70='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://sepolia.base.org wss://relay.damus.io wss://nos.lol https: http://127.0.0.1:* http://localhost:*; worker-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/build.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
