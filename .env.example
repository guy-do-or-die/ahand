# Repo-root environment — contracts & local infra only.
# The web app's env lives in apps/web/.env.example.

# ── Contracts (forge scripts) ────────────────────────────────────────────
# Etherscan v2 API key for contract verification during deploy scripts.
ETHERSCAN_V2_API_KEY=

# ── Local anvil stand (infra/anvil, `bun run stand`) — never needed on Vercel
# See infra/anvil/stand.ts for semantics; all optional with sane defaults.
AHAND_CHAIN=
AHAND_AA=
AHAND_ALTO_PORT=
AHAND_ALTO_LOG=
AHAND_PAYMASTER_PORT=
