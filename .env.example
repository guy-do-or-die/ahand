# Repo-root environment — contracts & local infra only.
# The web app has no environment file: its settings are apps/web/src/config/*.json.

# ── Contracts (forge scripts) ────────────────────────────────────────────
# Etherscan v2 API key for contract verification during deploy scripts.
ETHERSCAN_V2_API_KEY=

# ── Earlier anvil stand (infra/anvil) — never needed on Vercel
# The local stand is now infra/stand (`bun run stand`), which reads none of these.
# Legacy: read only by packages/subgraph/scripts/prepare.ts, which targets the earlier Core and
# does not build on this branch (see docs/README.md).
AHAND_CHAIN=
AHAND_AA=
AHAND_ALTO_PORT=
AHAND_ALTO_LOG=
AHAND_PAYMASTER_PORT=
